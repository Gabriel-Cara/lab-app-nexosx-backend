NOTIFICATION_PROVIDER=console

# Twilio (optional)
# Set NOTIFICATION_PROVIDER to twilio_sms, twilio_whatsapp, or both (comma-separated)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_SMS=+14155552671
# TWILIO_FROM_WHATSAPP=whatsapp:+14155238886

# Package pickup code settings
# 48h default
PACKAGE_CODE_TTL_MINUTES=2880
# Max invalid attempts before blocking
PACKAGE_CODE_MAX_ATTEMPTS=5
FRONT_URL=http://localhost:5173
RESEND_API_KEY=re_...
MAIL_FROM="Nexus <onboarding@resend.dev>"

