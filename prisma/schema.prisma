generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
  resident
}

enum ReservationStatus {
  pending
  approved
  rejected
  cancelled
}

enum PackageStatus {
  pending
  delayed
  retrieved
  cancelled
}

enum VisitorStatus {
  pending
  authorized
  denied
  entry
  left
}

enum PackageType {
  box
  envelope
  food
  others
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  phone              String?
  password           String
  role               Role              @default(resident)
  apartment          String?
  createdAt          DateTime          @default(now()) @map("created-at")
  updatedAt          DateTime          @updatedAt @map("updated-at")
  residents          ResidentInfo?
  packages           Package[]
  hostedVisits       VisitLog[]        @relation("visit-host")
  handledVisits      VisitLog[]        @relation("handled-by")
  createdPackages    Package[]         @relation("package-created-by")
  verifiedRetrievals RetrievalLog[]    @relation("verified-by")
  createdEvents      Event[]           @relation("event-created-by")
  eventBookings      EventBooking[]
  AreaReservation    AreaReservation[]

  @@map("users")
}

model ResidentInfo {
  id               String  @id @default(uuid())
  user             User    @relation(fields: [userId], references: [id])
  userId           String  @unique @map("user-id")
  building         String?
  vehicle          String?
  emergencyContact String? @map("emergency-contact")

  @@map("resident-infos")
}

model Visitor {
  id          String        @id @default(uuid())
  name        String
  document    String        @unique
  phone       String?
  visitReason String?       @map("visit-reason")
  status      VisitorStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created-at")
  updatedAt   DateTime      @updatedAt @map("updated-at")
  logs        VisitLog[]

  @@map("visitors")
}

model VisitLog {
  id          String        @id @default(uuid())
  visitor     Visitor       @relation(fields: [visitorId], references: [id])
  visitorId   String        @map("visitor-id")
  host        User          @relation("visit-host", fields: [hostId], references: [id])
  hostId      String        @map("host-id")
  entryTime   DateTime?     @map("entry-time")
  exitTime    DateTime?     @map("exit-time")
  notes       String?
  handledBy   User?         @relation("handled-by", fields: [handledById], references: [id])
  handledById String?
  status      VisitorStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created-at")

  @@map("visit-logs")
}

model Package {
  id            String         @id @default(uuid())
  code          String         @unique
  description   String
  carrier       String?
  type          PackageType
  status        PackageStatus  @default(pending)
  receivedAt    DateTime       @default(now()) @map("received-at")
  retrievedAt   DateTime?      @map("retrieved-at")
  deliveredAt   DateTime?      @map("delivered-at")
  resident      User           @relation(fields: [residentId], references: [id])
  residentId    String
  createdBy     User           @relation("package-created-by", fields: [createdById], references: [id])
  createdById   String
  retrievalLogs RetrievalLog[]

  @@map("packages")
}

model RetrievalLog {
  id           String   @id @default(uuid())
  package      Package  @relation(fields: [packageId], references: [id])
  packageId    String   @map("package-id")
  verifiedBy   User     @relation("verified-by", fields: [verifiedById], references: [id])
  verifiedById String
  verifiedAt   DateTime @default(now()) @map("verified-at")
  method       String

  @@map("retrieval-logs")
}

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  commonAreaId String
  location     CommonArea @relation(fields: [commonAreaId], references: [id])

  capacity    Int
  startDate   DateTime       @map("start-date")
  endDate     DateTime       @map("end-date")
  createdBy   User           @relation("event-created-by", fields: [createdById], references: [id])
  createdById String
  bookings    EventBooking[]

  @@map("events")
}

model EventBooking {
  id         String   @id @default(uuid())
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String   @map("event-id")
  resident   User     @relation(fields: [residentId], references: [id])
  residentId String   @map("resident-id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created-at")

  @@map("events-booking")
}

model CommonArea {
  id          String   @id @default(uuid())
  name        String
  description String?
  capacity    Int?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations AreaReservation[]
  Event        Event[]
  timeSlots    AreaTimeSlot[]

  @@map("areas")
}

model AreaReservation {
  id        String            @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  purpose   String?
  status    ReservationStatus @default(pending)
  createdAt DateTime          @default(now())

  areaId String
  area   CommonArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  startSlotId String?       @map("start-slot-id")
  startSlot   AreaTimeSlot? @relation("ReservationStartSlot", fields: [startSlotId], references: [id])

  endSlotId String?       @map("end-slot-id")
  endSlot   AreaTimeSlot? @relation("ReservationEndSlot", fields: [endSlotId], references: [id])

  residentId String
  resident   User   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([areaId, date, startTime, endTime])
  @@map("reservations")
}

model AreaTimeSlot {
  id        String        @id @default(uuid())
  label     String
  startsAt  String        @map("starts-at")
  endsAt    String        @map("ends-at")
  isActive  Boolean       @default(true) @map("is-active")
  sortOrder Int?          @map("sort-order")
  areaId    String        @map("area-id")
  area      CommonArea    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  startReservations AreaReservation[] @relation("ReservationStartSlot")
  endReservations   AreaReservation[] @relation("ReservationEndSlot")

  @@unique([areaId, startsAt, endsAt])
  @@map("area-time-slots")
}
