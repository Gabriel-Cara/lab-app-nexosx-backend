generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  master
  admin
  staff
  resident
}

enum ReservationStatus {
  pending
  approved
  rejected
  cancelled
}

enum PackageStatus {
  pending
  delayed
  retrieved
  cancelled
}

enum VisitorStatus {
  pending
  authorized
  denied
  entry
  left
}

enum PackageType {
  box
  envelope
  food
  others
}

enum CondominiumRequestStatus {
  pending
  approved
  rejected
}

model Condominium {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created-at")
  updatedAt DateTime @updatedAt @map("updated-at")

  users            User[]
  residentInfos    ResidentInfo[]
  visitors         Visitor[]
  visitLogs        VisitLog[]
  packages         Package[]
  retrievalLogs    RetrievalLog[]
  events           Event[]
  eventBookings    EventBooking[]
  eventLikes       EventLike[]
  commonAreas      CommonArea[]
  areaReservations AreaReservation[]
  areaTimeSlots    AreaTimeSlot[]
  requests         CondominiumRequest[]
  staffInvites     StaffInvite[]
  residentInvites  ResidentInvite[]

  @@map("condominiums")
}

model CondominiumRequest {
  id                String   @id @default(uuid())
  name              String
  code              String
  adminName         String   @map("admin-name")
  adminEmail        String   @map("admin-email")
  adminPhone        String?  @map("admin-phone")
  adminPasswordHash String   @map("admin-password-hash")
  status            CondominiumRequestStatus @default(pending)
  createdAt         DateTime @default(now()) @map("created-at")
  decidedAt         DateTime? @map("decided-at")
  rejectionReason   String?  @map("rejection-reason")
  decisionById      String?  @map("decision-by-id")
  decisionBy        User?    @relation("condominium-request-decided-by", fields: [decisionById], references: [id])
  condominiumId     String?  @map("condominium-id")
  condominium       Condominium? @relation(fields: [condominiumId], references: [id])

  @@unique([code])
  @@map("condominium-requests")
}

model StaffInvite {
  id             String      @id @default(uuid())
  tokenHash      String      @unique @map("token-hash")
  condominiumId  String      @map("condominium-id")
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  createdById    String?     @map("created-by-id")
  createdBy      User?       @relation("staff-invite-created-by", fields: [createdById], references: [id])
  expiresAt      DateTime    @map("expires-at")
  createdAt      DateTime    @default(now()) @map("created-at")

  @@index([condominiumId])
  @@index([expiresAt])
  @@map("staff-invites")
}

model ResidentInvite {
  id             String      @id @default(uuid())
  tokenHash      String      @unique @map("token-hash")
  condominiumId  String      @map("condominium-id")
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  createdById    String?     @map("created-by-id")
  createdBy      User?       @relation("resident-invite-created-by", fields: [createdById], references: [id])
  expiresAt      DateTime    @map("expires-at")
  createdAt      DateTime    @default(now()) @map("created-at")

  @@index([condominiumId])
  @@index([expiresAt])
  @@map("resident-invites")
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String
  phone              String?
  imageUrl           String?           @map("image-url")
  password           String
  role               Role              @default(resident)
  condominiumId      String?           @map("condominium-id")
  condominium        Condominium?      @relation(fields: [condominiumId], references: [id])
  apartment          String?
  shift              String?
  createdAt          DateTime          @default(now()) @map("created-at")
  updatedAt          DateTime          @updatedAt @map("updated-at")
  residents          ResidentInfo?
  packages           Package[]
  hostedVisits       VisitLog[]        @relation("visit-host")
  handledVisits      VisitLog[]        @relation("handled-by")
  createdPackages    Package[]         @relation("package-created-by")
  verifiedRetrievals RetrievalLog[]    @relation("verified-by")
  createdEvents      Event[]           @relation("event-created-by")
  eventBookings      EventBooking[]
  AreaReservation    AreaReservation[]
  decidedRequests    CondominiumRequest[] @relation("condominium-request-decided-by")

  passwordSetupToken PasswordSetupToken?
  passwordResetTokens PasswordResetToken[]
  eventLikes         EventLike[]
  staffInvitesCreated StaffInvite[]     @relation("staff-invite-created-by")
  residentInvitesCreated ResidentInvite[] @relation("resident-invite-created-by")

  @@unique([condominiumId, email])
  @@map("users")
}

model PasswordSetupToken {
  id     String @id @default(uuid())
  userId String @unique @map("user-id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token-hash")
  expiresAt DateTime  @map("expires-at")
  usedAt    DateTime? @map("used-at")

  createdAt DateTime @default(now()) @map("created-at")

  @@index([expiresAt])
  @@map("password-setup-tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user-id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token-hash")
  expiresAt DateTime @map("expires-at")
  usedAt    DateTime? @map("used-at")

  createdAt DateTime @default(now()) @map("created-at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password-reset-tokens")
}

model ResidentInfo {
  id               String  @id @default(uuid())
  user             User    @relation(fields: [userId], references: [id])
  userId           String  @unique @map("user-id")
  condominiumId    String  @map("condominium-id")
  condominium      Condominium @relation(fields: [condominiumId], references: [id])
  building         String?
  vehicle          String?
  emergencyContact String? @map("emergency-contact")

  @@map("resident-infos")
}

model Visitor {
  id          String        @id @default(uuid())
  name        String
  document    String
  phone       String?
  visitReason String?       @map("visit-reason")
  status      VisitorStatus @default(pending)
  condominiumId String      @map("condominium-id")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  createdAt   DateTime      @default(now()) @map("created-at")
  updatedAt   DateTime      @updatedAt @map("updated-at")
  logs        VisitLog[]

  @@unique([condominiumId, document])
  @@map("visitors")
}

model VisitLog {
  id          String        @id @default(uuid())
  visitor     Visitor       @relation(fields: [visitorId], references: [id])
  visitorId   String        @map("visitor-id")
  host        User          @relation("visit-host", fields: [hostId], references: [id])
  hostId      String        @map("host-id")
  entryTime   DateTime?     @map("entry-time")
  exitTime    DateTime?     @map("exit-time")
  notes       String?
  handledBy   User?         @relation("handled-by", fields: [handledById], references: [id])
  handledById String?
  status      VisitorStatus @default(pending)
  imageUrl    String?       @map("image-url")
  condominiumId String      @map("condominium-id")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  createdAt   DateTime      @default(now()) @map("created-at")

  @@map("visit-logs")
}

model Package {
  id            String         @id @default(uuid())
  codeHash      String         @unique @map("code-hash")
  codeExpiresAt DateTime       @map("code-expires-at")
  codeAttempts  Int            @default(0) @map("code-attempts")
  codeHint      String?        @map("code-hint")
  description   String
  carrier       String?
  type          PackageType
  status        PackageStatus  @default(pending)
  imageUrl      String?        @map("image-url")
  condominiumId String         @map("condominium-id")
  condominium   Condominium    @relation(fields: [condominiumId], references: [id])
  receivedAt    DateTime       @default(now()) @map("received-at")
  retrievedAt   DateTime?      @map("retrieved-at")
  deliveredAt   DateTime?      @map("delivered-at")
  resident      User           @relation(fields: [residentId], references: [id])
  residentId    String
  createdBy     User           @relation("package-created-by", fields: [createdById], references: [id])
  createdById   String
  retrievalLogs RetrievalLog[]

  @@map("packages")
}

model RetrievalLog {
  id           String   @id @default(uuid())
  package      Package  @relation(fields: [packageId], references: [id])
  packageId    String   @map("package-id")
  verifiedBy   User     @relation("verified-by", fields: [verifiedById], references: [id])
  verifiedById String
  verifiedAt   DateTime @default(now()) @map("verified-at")
  method       String
  condominiumId String   @map("condominium-id")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])

  @@map("retrieval-logs")
}

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  commonAreaId String
  location     CommonArea @relation(fields: [commonAreaId], references: [id])

  capacity    Int
  allowBookings Boolean       @default(true) @map("allow-bookings")
  imageUrl    String?         @map("image-url")
  condominiumId String         @map("condominium-id")
  condominium   Condominium    @relation(fields: [condominiumId], references: [id])
  startDate   DateTime       @map("start-date")
  endDate     DateTime       @map("end-date")
  createdBy   User           @relation("event-created-by", fields: [createdById], references: [id])
  createdById String
  bookings    EventBooking[]
  likes       EventLike[]

  @@map("events")
}

model EventBooking {
  id         String   @id @default(uuid())
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String   @map("event-id")
  resident   User     @relation(fields: [residentId], references: [id])
  residentId String   @map("resident-id")
  notes      String?
  condominiumId String   @map("condominium-id")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  createdAt  DateTime @default(now()) @map("created-at")

  @@unique([eventId, residentId])
  @@map("events-booking")
}

model EventLike {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String   @map("event-id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user-id")
  condominiumId String   @map("condominium-id")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  createdAt DateTime @default(now()) @map("created-at")

  @@unique([eventId, userId])
  @@map("event-likes")
}

model CommonArea {
  id          String   @id @default(uuid())
  name        String
  description String?
  capacity    Int?
  available   Boolean  @default(true)
  imageUrl    String?  @map("image-url")
  condominiumId String  @map("condominium-id")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations AreaReservation[]
  Event        Event[]
  timeSlots    AreaTimeSlot[]

  @@unique([condominiumId, name])
  @@map("areas")
}

model AreaReservation {
  id        String            @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  purpose   String?
  status    ReservationStatus @default(pending)
  createdAt DateTime          @default(now())
  condominiumId String         @map("condominium-id")
  condominium   Condominium    @relation(fields: [condominiumId], references: [id])

  areaId String
  area   CommonArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  startSlotId String?       @map("start-slot-id")
  startSlot   AreaTimeSlot? @relation("ReservationStartSlot", fields: [startSlotId], references: [id])

  endSlotId String?       @map("end-slot-id")
  endSlot   AreaTimeSlot? @relation("ReservationEndSlot", fields: [endSlotId], references: [id])

  residentId String
  resident   User   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([areaId, date, startTime, endTime])
  @@map("reservations")
}

model AreaTimeSlot {
  id                String            @id @default(uuid())
  label             String
  startsAt          String            @map("starts-at")
  endsAt            String            @map("ends-at")
  isActive          Boolean           @default(true) @map("is-active")
  sortOrder         Int?              @map("sort-order")
  areaId            String            @map("area-id")
  area              CommonArea        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  condominiumId     String            @map("condominium-id")
  condominium       Condominium       @relation(fields: [condominiumId], references: [id])
  startReservations AreaReservation[] @relation("ReservationStartSlot")
  endReservations   AreaReservation[] @relation("ReservationEndSlot")

  @@unique([areaId, startsAt, endsAt])
  @@map("area-time-slots")
}
